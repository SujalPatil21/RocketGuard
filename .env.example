# AP Sentinel — Environment Variable Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ==========================================
# LOCAL DEVELOPMENT ONLY
# ==========================================

# ─── RocketRide Local ─────────────────────────────────────────────────────────
# Uncomment and use this for local development with the RocketRide Local Extension
ROCKETRIDE_URI=http://127.0.0.1:5565
ROCKETRIDE_APIKEY=local-dev-key

# ─── Neo4j (fraud relationship graph) ──────────────────────────────────────────
# Aura Free: create an instance at neo4j.com/cloud/aura-free and paste its values here.
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USER=your-instance-id
NEO4J_PASSWORD=your-generated-password

# ─── Demo mode (Local only) ───────────────────────────────────────────────────
# true  → OTPs printed to server console (no SMTP required)
# false → OTPs sent via SMTP (requires SMTP_EMAIL + SMTP_PASSWORD)
DEMO_MODE=true

# ==========================================
# PRODUCTION DEPLOYMENT ONLY
# ==========================================

# ─── RocketRide Cloud ─────────────────────────────────────────────────────────
# For production, do NOT set ROCKETRIDE_URI. The SDK will default to Cloud.
# ROCKETRIDE_URI=
# ROCKETRIDE_APIKEY=
# ROCKETRIDE_GEMINI_APIKEY=

# ─── FastAPI / Railway ────────────────────────────────────────────────────────
# Railway injects $PORT automatically.
CORS_ORIGINS=https://your-frontend.pages.dev

# ─── Auth / JWT ──────────────────────────────────────────────────────────────
PROJECT_NAME=AP Sentinel
DATABASE_URL=postgresql://user:password@containers-us-west-XX.railway.app:5432/railway
JWT_SECRET=your-strong-random-secret-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── SMTP (Required for Production) ───────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# ─── OTP ─────────────────────────────────────────────────────────────────────
OTP_EXPIRY=300
RESEND_DELAY=45
ENABLE_LOGIN_OTP=false

# ==========================================
# FRONTEND (Vite / Cloudflare Pages)
# ==========================================
# Make sure to set this in Cloudflare Pages environment variables
VITE_API_BASE_URL=https://your-backend.up.railway.app
