# AP Sentinel — Environment Variable Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ─── RocketRide ──────────────────────────────────────────────────────────────
ROCKETRIDE_URI=http://127.0.0.1:<PORT>
ROCKETRIDE_APIKEY=your-rocketride-api-key

# ─── Auth / JWT ──────────────────────────────────────────────────────────────
PROJECT_NAME=AP Sentinel
DATABASE_URL=sqlite:///./auth.db
JWT_SECRET=your-strong-random-secret-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── SMTP (leave blank when DEMO_MODE=true) ───────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# ─── OTP ─────────────────────────────────────────────────────────────────────
OTP_EXPIRY=300
RESEND_DELAY=45
ENABLE_LOGIN_OTP=true

# ─── Demo mode ────────────────────────────────────────────────────────────────
# true  → OTPs printed to server console (no SMTP required)
# false → OTPs sent via SMTP (requires SMTP_EMAIL + SMTP_PASSWORD)
DEMO_MODE=true
